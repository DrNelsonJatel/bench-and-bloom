---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { langFromUrl } from '../../i18n/config';
import { useTranslations } from '../../i18n/utils';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);

const en = await getCollection('recipes');
// French entries are matched by slug. Grouping and ordering still key off the ENGLISH
// data (spirit is a data key, not display text), so a recipe without a translation keeps
// its place in the hub and simply renders its English title.
const fr = lang === 'fr' ? await getCollection('recipes-fr') : [];
const pick = (e: any) => fr.find((r) => r.id === e.id) ?? e;
const recipes = en.map((e) => ({ ...e, data: { ...e.data, ...pick(e).data,
  spirit: e.data.spirit, kind: e.data.kind, order: e.data.order, signature: e.data.signature } }))
  .sort((a, b) => a.data.order - b.data.order);
const anchor = recipes.find((r) => r.data.kind === 'anchor');
const drinks = recipes.filter((r) => r.data.kind !== 'anchor');

const signatures = drinks.filter((r) => r.data.signature);
const rest = drinks.filter((r) => !r.data.signature);
const gin = rest.filter((r) => r.data.spirit === 'Gin');
const vodka = rest.filter((r) => r.data.spirit === 'Vodka');
const noalc = rest.filter((r) => r.data.kind === 'mocktail');

const groups = [
  { label: t('recipes.grpSignature'), note: t('recipes.grpSignatureNote'), items: signatures },
  { label: t('recipes.grpClassics'), note: 'Gin', items: gin },
  { label: t('recipes.grpVodka'), note: 'Vodka', items: vodka },
  { label: t('recipes.grpNoAlc'), note: t('recipes.tagMocktail'), items: noalc },
].filter((g) => g.items.length);

// spirit is a data key kept in English for grouping; translate it only for display.
const SPIRIT_FR: Record<string, string> = { Gin: 'Gin', Vodka: 'Vodka', 'Sparkling wine': 'Vin mousseux' };
const spiritLabel = (s?: string) => (s && lang === 'fr' ? SPIRIT_FR[s] ?? s : s);
const tag = (r: any) =>
  r.data.signature ? t('recipes.tagSignature')
  : r.data.kind === 'mocktail' ? t('recipes.tagMocktail')
  : spiritLabel(r.data.spirit) ?? t('recipes.tagCocktail');

const title = 'Lavender Cocktails & Recipes';
const description =
  'Lavender syrup recipes for gin and vodka cocktails and mocktails: the colour-changing ' +
  'Lavender Milk, the Naramata Sunset, gin fizz, French 75, Moscow mule, lemonade and lattes. ' +
  'Stir it into warm milk and watch it bloom from ruby to lavender violet.';
---

<Base title={title} description={description} heroImage="/images/lavender-bees.jpg">
  <section class="hero hero--photo" style="--hero-img:url('/images/lavender-bees.jpg')">
    <div class="wrap hero__inner">
      <p class="eyebrow">{t('recipes.eyebrow')}</p>
      <h1>{t('recipes.title')}</h1>
      <p class="hero__lede">
        {t('recipes.lede')}
      </p>
    </div>
  </section>

  {anchor && (
    <section class="section wrap">
      <a class="feature" href={`/recipes/${anchor.id}`}>
        <div>
          <p class="eyebrow">Start here</p>
          <h2 class="mt-0">{anchor.data.title}</h2>
          <p>{anchor.data.description}</p>
          <span class="feature__link">Read the how-to</span>
        </div>
        <img class="media" loading="lazy" decoding="async" src="/images/harvest-field.jpg" width="1400" height="1050"
          loading="lazy" decoding="async"
          alt="Cut lavender hauled from the field, on its way to becoming syrup" />
      </a>
    </section>
  )}

  <section class="section section--surface">
    <div class="wrap">
      {groups.map((g, i) => (
        <div class={i > 0 ? 'group' : ''}>
          <p class="eyebrow">{g.note}</p>
          <h2>{g.label}</h2>
          <div class="cards">
            {g.items.map((r) => (
              <a class="card card--link" href={`/recipes/${r.id}`}>
                <p class="eyebrow">{tag(r)}</p>
                <h3>{r.data.title}</h3>
                <p>{r.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .feature { display: grid; gap: clamp(1.5rem, 5vw, 3rem); grid-template-columns: 1fr; align-items: center; text-decoration: none; color: inherit; }
  @media (min-width: 820px) { .feature { grid-template-columns: 1.1fr 0.9fr; } }
  .feature h2 { color: var(--lavender-deep); }
  .feature p { color: var(--ink-soft); }
  .feature__link { color: var(--lavender-deep); font-weight: 600; }
  .feature:hover .feature__link { color: var(--gold-deep); }
  .group { margin-top: clamp(2.25rem, 5vw, 3.5rem); }
  .card--link { text-decoration: none; color: inherit; transition: border-color 0.15s ease, transform 0.15s ease; }
  .card--link:hover { border-color: var(--gold); transform: translateY(-2px); }
  .card--link:hover h3 { color: var(--lavender-deep); }
</style>
