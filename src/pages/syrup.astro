---
import Base from '../layouts/Base.astro';
import BuyButton from '../components/BuyButton.astro';
import { SITE } from '../consts';
import { langFromUrl, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);


const title = 'The Syrup';
const description =
  'Bench & Bloom lavender syrup: estate-grown Grosso lavender, earthy and warm rather than high ' +
  'floral, with butterfly pea flower, ' +
  'steeped and strained, no essential oils, no artificial colour. A deep ruby that blooms ' +
  'to lavender violet in warm milk. Grown on the Naramata Bench.';

// Product JSON-LD without Offer until the Amazon.ca listing and price exist.
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Bench & Bloom Lavender Syrup',
  brand: { '@type': 'Brand', name: SITE.title },
  category: 'Cocktail syrup',
  description,
  url: new URL('/syrup', SITE.url).href,
};
---

<Base title={title} description={description} heroImage="/images/lavender-closeup.jpg">
  <section class="hero hero--photo" style="--hero-img:url('/images/lavender-closeup.jpg')">
    <div class="wrap hero__inner">
      <p class="eyebrow">{SITE.descriptor}</p>
      <h1>{t('syrup.title')}</h1>
      <p class="hero__lede">
        {t('syrup.lede')}
      </p>
      <div class="cta-row"><BuyButton /></div>
    </div>
  </section>

  <section class="section wrap split">
    <div>
      <p class="eyebrow">{t('syrup.whatEyebrow')}</p>
      <h2>{t('syrup.whatTitle')}</h2>
      <p>
        Lavender, butterfly pea flower, cane sugar, water and a little citric acid. That is the
        whole list. Full <a href="/nutrition">nutrition facts and specifications</a>, including
        what we have and have not measured yet, are on their own page. The lavender is
        our own estate-grown lavender, <strong>Grosso</strong> (<em>Lavandula</em> &times;
        <em>intermedia</em> &lsquo;Grosso&rsquo;), grown on the Naramata property and steeped as
        whole buds, never an extract or a flavouring. We strain it and balance it so the lavender reads warm
        and clean, never soapy. That balance is the hard part, and the part we obsess over.
      </p>
      <p>
        Butterfly pea flower gives the syrup its colour, no dye. The citric acid keeps it bright and
        sets the butterfly pea to a deep ruby in the bottle. Stir it into warm milk and the colour runs the other way, blooming to a soft
        lavender violet.
      </p>
      <p>
        There is a reason we grow Grosso. It is a lavandin, a cross between English lavender and
        spike lavender, and it does not taste like the lavender most people have met. Where English
        lavender is sweet and high floral, Grosso is <strong>earthier and warmer</strong>, less
        perfume and more herb. That is the half of lavender that survives a drink. It reads clearly
        through gin, tonic or coffee, where a softer, more floral lavender turns soapy or simply
        disappears. We steep whole buds for three minutes, strain them out, and never add extracted
        essential oil or flavouring to the bottle.
      </p>
    </div>
    <img class="media" loading="lazy" decoding="async" src="/images/lavender-bundle-lake.jpg" width="1125" height="1500"
      loading="lazy" decoding="async"
      alt="A freshly cut bundle of Grosso lavender on the deck, Okanagan Lake in the distance" />
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <p class="eyebrow">{t('syrup.useEyebrow')}</p>
      <h2>{t('syrup.useTitle')}</h2>
      <div class="cards">
        <article class="card"><h3>The colour-change one</h3><p>Our signature <a href="/recipes/lavender-milk">Lavender Milk</a> goes in ruby and turns lavender violet in the cup.</p></article>
        <article class="card"><h3>Gin or vodka</h3><p>Bold enough for both. Try a <a href="/recipes/lavender-gin-fizz">Gin Fizz</a>, a <a href="/recipes/lavender-french-75">French 75</a> or a <a href="/recipes/lavender-moscow-mule">vodka mule</a>.</p></article>
        <article class="card"><h3>No alcohol</h3><p>Every pour works as a mocktail. A <a href="/recipes/lavender-lemonade">Lavender Lemonade</a> or an <a href="/recipes/lavender-latte">iced latte</a> is the easy one.</p></article>
      </div>
    </div>
  </section>

  <section class="section wrap center">
    <h2>{t('syrup.soonTitle')}</h2>
    <p class="lede" style="margin-inline:auto;">A small first batch. <a href="/#launch">Leave your email</a> and we will tell you the day it goes live.</p>
    <div class="cta-row" style="justify-content:center;"><BuyButton /></div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(productLd)} />
</Base>
